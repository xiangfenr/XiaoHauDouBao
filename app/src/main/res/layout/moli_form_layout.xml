<?xml version="1.0" encoding="utf-8"?><!--智享贷 表单-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FFFFFF"
            android:orientation="vertical"
            tools:context="com.example.yongliu.bottomnavigationview.MainActivity">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/d_dp_16"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_data"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/d_dp_12"
                    android:text="真实姓名"
                    android:textColor="#000000"
                    android:textSize="@dimen/d_sp_16"
                    app:layout_constraintLeft_toLeftOf="parent" />

                <EditText
                    android:id="@+id/tv_zhong_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_marginStart="@dimen/d_dp_16"
                    android:layout_marginTop="@dimen/d_dp_12"
                    android:layout_marginEnd="@dimen/d_dp_16"
                    android:autofillHints=""
                    android:text=""
                    android:background="@color/color_ffffff"
                    android:gravity="end"
                    android:hint="请输入本人真实姓名"
                    android:maxWidth="@dimen/d_dp_300"
                    android:textColor="#000000"
                    android:textSize="@dimen/d_sp_16"
                    app:layout_constraintEnd_toEndOf="parent" />

            </RelativeLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginStart="@dimen/d_dp_16"
                android:layout_marginTop="@dimen/d_dp_15"
                android:alpha="0.1"
                android:background="#000000"
                android:visibility="gone"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_zhong" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/d_dp_16"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/d_dp_12"
                    android:text="手机号"
                    android:textColor="#000000"
                    android:textSize="@dimen/d_sp_16"
                    app:layout_constraintLeft_toLeftOf="parent" />

                <EditText
                    android:id="@+id/tv_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_marginStart="@dimen/d_dp_16"
                    android:layout_marginTop="@dimen/d_dp_12"
                    android:layout_marginEnd="@dimen/d_dp_16"
                    android:autofillHints=""
                    android:background="@color/color_ffffff"
                    android:gravity="end"
                    android:hint="请输入手机号码"
                    android:inputType="number"
                    android:maxWidth="@dimen/d_dp_300"
                    android:textColor="#000000"
                    android:textSize="@dimen/d_sp_16"
                    app:layout_constraintEnd_toEndOf="parent" />

            </RelativeLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginStart="@dimen/d_dp_16"
                android:layout_marginTop="@dimen/d_dp_15"
                android:alpha="0.1"
                android:background="#000000"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_zhong" />


            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/d_dp_16"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/d_dp_12"
                    android:text="身份证号"
                    android:textColor="#000000"
                    android:textSize="@dimen/d_sp_16"
                    app:layout_constraintLeft_toLeftOf="parent" />

                <EditText
                    android:id="@+id/tv_idcard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_marginStart="@dimen/d_dp_16"
                    android:layout_marginTop="@dimen/d_dp_12"
                    android:layout_marginEnd="@dimen/d_dp_16"
                    android:autofillHints=""
                    android:text=""
                    android:background="@color/color_ffffff"
                    android:gravity="end"
                    android:hint="请输入本人真实身份证号"
                    android:inputType="textPersonName|textFilter"
                    android:maxWidth="@dimen/d_dp_300"
                    android:maxLength="18"
                    android:textColor="#000000"
                    android:textSize="@dimen/d_sp_16"
                    app:layout_constraintEnd_toEndOf="parent" />

            </RelativeLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginStart="@dimen/d_dp_16"
                android:layout_marginTop="@dimen/d_dp_15"
                android:alpha="0.1"
                android:background="#000000"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_zhong" />

            <RelativeLayout
                android:id="@+id/addressRela"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginHorizontal="@dimen/d_dp_16"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="工作城市"
                    android:textColor="#000000"
                    android:textSize="@dimen/d_sp_16"
                    app:layout_constraintLeft_toLeftOf="parent" />


                <TextView
                    android:id="@+id/address"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:drawableEnd="@mipmap/icon_right"
                    android:text="请选择城市"
                    android:textColor="#000000"
                    android:textSize="@dimen/d_sp_16" />

            </RelativeLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginStart="@dimen/d_dp_16"
                android:layout_marginTop="@dimen/d_dp_15"
                android:alpha="0.1"
                android:background="#000000"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_zhong" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/d_dp_16"
                android:layout_marginTop="20dp"
                android:text="芝麻信用分"
                android:textStyle="bold"
                android:textColor="#000000"
                android:textSize="@dimen/d_sp_16"
                app:layout_constraintLeft_toLeftOf="parent" />

            <com.yundou.loans.widget.SingleSelectButtonGroup
                android:id="@+id/sesame_score_Group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
               android:padding="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/d_sp_16"
                android:text="资质情况(多选)"
                android:textColor="#000000"
                android:textStyle="bold"
                android:textSize="@dimen/d_sp_18"
                app:layout_constraintLeft_toLeftOf="parent" />

            <com.yundou.loans.widget.MultiSelectButtonGroup
                android:id="@+id/occupationGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
               android:padding="10dp" />


            <TextView
                android:id="@+id/txt_feedback_submit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_marginLeft="30dip"
                android:layout_marginTop="20dip"
                android:layout_marginRight="30dip"
                android:layout_marginBottom="30dip"
                android:background="@drawable/logincodebg"
                android:gravity="center"
                android:paddingTop="10dip"
                android:paddingBottom="12dip"
                android:text="提交申请"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:gravity="center_horizontal"
                android:text="@string/app_icp"
                android:visibility="gone"
                android:textSize="@dimen/d_sp_12" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:paddingBottom="@dimen/dp_20"
                android:text="@string/app_gongsi"
                android:textSize="@dimen/d_sp_12" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</layout>
