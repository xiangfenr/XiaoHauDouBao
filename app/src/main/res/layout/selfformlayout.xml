<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#FFFFFF"
    android:orientation="vertical"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/d_dp_16"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_data"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/d_dp_12"
            android:text="真实姓名"
            android:textColor="#000000"
            android:textSize="@dimen/d_sp_16"
            app:layout_constraintLeft_toLeftOf="parent" />

        <EditText
            android:id="@+id/tv_zhong_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_marginStart="@dimen/d_dp_16"
            android:layout_marginTop="@dimen/d_dp_12"
            android:layout_marginEnd="@dimen/d_dp_16"
            android:autofillHints=""
            android:background="@color/color_ffffff"
            android:gravity="end"
            android:hint="请输入本人真实姓名"
            android:maxWidth="@dimen/d_dp_300"
            android:textColor="#000000"
            android:textSize="@dimen/d_sp_16"
            app:layout_constraintEnd_toEndOf="parent" />

    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginStart="@dimen/d_dp_16"
        android:layout_marginTop="@dimen/d_dp_15"
        android:alpha="0.1"
        android:visibility="gone"
        android:background="#000000"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_zhong" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/d_dp_16"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/d_dp_12"
            android:text="手机号"
            android:textColor="#000000"
            android:textSize="@dimen/d_sp_16"
            app:layout_constraintLeft_toLeftOf="parent" />

        <EditText
