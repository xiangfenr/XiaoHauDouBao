<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@mipmap/form_bg_orange">
        <!--        <TextView-->
        <!--            android:layout_width="match_parent"-->
        <!--            android:layout_height="400dp"-->
        <!--            android:background="@mipmap/form_top_bg"-->
        <!--          />-->

        <RelativeLayout
            android:id="@+id/title_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="60dp">

            <ImageView
                android:id="@+id/back"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:padding="6dp"
                android:src="@mipmap/turn_left_black" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="申请贷款"
                android:textColor="@color/black" />
        </RelativeLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/title_container">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/d_dp_20"
                android:background="@drawable/bottom_list_bg"
                android:orientation="vertical"
                android:padding="@dimen/d_dp_20"
                tools:context="com.example.yongliu.bottomnavigationview.MainActivity">

                <TextView
                    android:id="@+id/jibenxinxi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableStart="@mipmap/form_bg"
                    android:drawablePadding="4dp"
                    android:text="基本信息"
                    android:textColor="#222"
                    android:textSize="16dp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/gray_button_bg"
                    android:orientation="vertical">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/d_dp_16"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_data"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/d_dp_12"
                            android:text="姓名"
                            android:textColor="#000000"
                            android:textSize="@dimen/d_sp_16"
                            app:layout_constraintLeft_toLeftOf="parent" />

                        <EditText
                            android:id="@+id/tv_zhong_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_marginStart="@dimen/d_dp_16"
                            android:layout_marginTop="@dimen/d_dp_12"
                            android:autofillHints=""
                            android:background="@null"
                            android:gravity="end"
                            android:hint="请输入您的真实姓名"
                            android:maxWidth="@dimen/d_dp_300"
                            android:textColor="#000000"
                            android:textSize="@dimen/d_sp_16"
                            app:layout_constraintEnd_toEndOf="parent" />

                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/d_dp_16"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/d_dp_12"
                            android:text="手机号"
                            android:textColor="#000000"
                            android:textSize="@dimen/d_sp_16"
                            app:layout_constraintLeft_toLeftOf="parent" />

                        <EditText
                            android:id="@+id/tv_number"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_marginStart="@dimen/d_dp_16"
                            android:layout_marginTop="@dimen/d_dp_12"
                            android:layout_marginEnd="@dimen/d_dp_16"
                            android:autofillHints=""
                            android:background="@color/color_ffffff"
                            android:gravity="end"
                            android:hint="请输入手机号码"
                            android:inputType="number"
                            android:maxWidth="@dimen/d_dp_300"
                            android:textColor="#000000"
                            android:textSize="@dimen/d_sp_16"
                            app:layout_constraintEnd_toEndOf="parent" />

                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginHorizontal="@dimen/d_dp_16"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/d_dp_12"
                            android:text="身份证号"
                            android:textColor="#000000"
                            android:textSize="@dimen/d_sp_16"
                            app:layout_constraintLeft_toLeftOf="parent" />

                        <EditText
                            android:id="@+id/tv_idcard"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_marginStart="@dimen/d_dp_16"
                            android:layout_marginTop="@dimen/d_dp_12"
                            android:autofillHints=""
                            android:background="@null"
                            android:gravity="end"
                            android:hint="请输入身份证号"
                            android:inputType="textPersonName|textFilter"
                            android:maxWidth="@dimen/d_dp_300"
                            android:maxLength="18"
                            android:textColor="#000000"
                            android:textSize="@dimen/d_sp_16"
                            app:layout_constraintEnd_toEndOf="parent" />

                    </RelativeLayout>


                </LinearLayout>

                <TextView
                    android:id="@+id/jibenxinxi2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="@dimen/d_dp_10"
                    android:drawableStart="@mipmap/form_bg"
                    android:drawablePadding="4dp"
                    android:text="当前居住地址"
                    android:textColor="#222"
                    android:textSize="16dp"
                    android:textStyle="bold" />

                <RelativeLayout
                    android:id="@+id/addressRela"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/gray_button_bg"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="工作城市"
                        android:textColor="#000000"
                        android:textSize="@dimen/d_sp_16"
                        app:layout_constraintLeft_toLeftOf="parent" />


                    <TextView
                        android:id="@+id/address"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:drawableEnd="@mipmap/icon_right"
                        android:text="请选择城市"
                        android:textColor="#555"
                        android:textSize="@dimen/d_sp_16" />

                </RelativeLayout>

                <TextView
                    android:id="@+id/jibenxinxi3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="@dimen/d_dp_10"
                    android:drawableStart="@mipmap/form_bg"
                    android:drawablePadding="4dp"
                    android:text="其他信息"
                    android:textColor="#222"
                    android:textSize="16dp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:orientation="vertical"
                    android:paddingHorizontal="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginRight="10dp"
                        android:text="芝麻信用分"
                        android:textColor="#000000"
                        android:textSize="15dp" />

                    <com.yundou.loans.widget.SingleSelectButtonGroup
                        android:id="@+id/zhima_Group"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_alignParentRight="true" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:orientation="vertical"
                    android:paddingHorizontal="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginRight="10dp"
                        android:text="信用卡"
                        android:textColor="#000000"
                        android:textSize="15dp"
                        app:layout_constraintLeft_toLeftOf="parent" />

                    <com.yundou.loans.widget.SingleSelectButtonGroup
                        android:id="@+id/xinyongqk_Group"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_alignParentRight="true" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:orientation="vertical"
                    android:paddingHorizontal="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginRight="10dp"
                        android:text="商业保险"
                        android:textColor="#000000"
                        android:textSize="15dp"
                        app:layout_constraintLeft_toLeftOf="parent" />

                    <com.yundou.loans.widget.SingleSelectButtonGroup
                        android:id="@+id/shangbao_Group"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_alignParentRight="true" />

                </LinearLayout>


                <TextView
                    android:id="@+id/txt_feedback_submit"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:layout_below="@+id/lilvTv"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="50dp"
                    android:layout_marginRight="20dp"
                    android:background="@drawable/loginco"
                    android:gravity="center"
                    android:text="立即申请"
                    android:textColor="@color/white"
                    android:textSize="20dp"
                  />


                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:paddingBottom="@dimen/dp_20"
                    android:text="@string/app_gongsi"
                    android:textSize="@dimen/d_sp_12" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </RelativeLayout>
</layout>
