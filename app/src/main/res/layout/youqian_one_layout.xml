<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FFFFFF"
            android:orientation="vertical"
            tools:context="com.example.yongliu.bottomnavigationview.MainActivity">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="15dp"
                android:background="@drawable/main_color_bg"
                android:paddingHorizontal="10dp"
                android:paddingTop="20dp"
                android:paddingBottom="10dp">

                <ImageView
                    android:id="@+id/imgyuanquan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/jibenxinxi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:text="完成个人信息"
                    android:textColor="#222"
                    android:textSize="16dp"
                    android:textStyle="bold"
                    app:layout_constraintLeft_toRightOf="@+id/imgyuanquan"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/nametextview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:text="仅用于核验身份及保障您的账户安全\n 资料将被加密保护"
                    android:textColor="#666"
                    android:textSize="12dp"
                    app:layout_constraintLeft_toRightOf="@+id/imgyuanquan"
                    app:layout_constraintTop_toBottomOf="@+id/jibenxinxi" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical"
                    app:layout_constraintTop_toBottomOf="@+id/nametextview">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/d_dp_16"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_data"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/d_dp_12"
                            android:text="姓名"
                            android:textColor="#000000"
                            android:textSize="@dimen/d_sp_16"
                            app:layout_constraintLeft_toLeftOf="parent" />

                        <EditText
                            android:id="@+id/tv_zhong_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_marginStart="@dimen/d_dp_16"
                            android:layout_marginTop="@dimen/d_dp_12"
                            android:layout_marginEnd="@dimen/d_dp_16"
                            android:autofillHints=""
                            android:background="@null"
                            android:gravity="end"
                            android:text=""
                            android:hint="请输入您的真实姓名"
                            android:maxWidth="@dimen/d_dp_300"
                            android:textColor="#000000"
                            android:textSize="@dimen/d_sp_16"
                            app:layout_constraintEnd_toEndOf="parent" />

                    </RelativeLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginHorizontal="10dp"
                        android:layout_marginTop="@dimen/d_dp_15"
                        android:background="#eee"
                        android:visibility="visible"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tv_zhong" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/d_dp_16"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/d_dp_12"
                            android:text="手机号"
                            android:textColor="#000000"
                            android:textSize="@dimen/d_sp_16"
                            app:layout_constraintLeft_toLeftOf="parent" />

                        <EditText
                            android:id="@+id/tv_number"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_marginStart="@dimen/d_dp_16"
                            android:layout_marginTop="@dimen/d_dp_12"
                            android:layout_marginEnd="@dimen/d_dp_16"
                            android:autofillHints=""
                            android:background="@color/color_ffffff"
                            android:gravity="end"
                            android:hint="请输入手机号码"
                            android:inputType="number"
                            android:maxWidth="@dimen/d_dp_300"
                            android:textColor="#000000"
                            android:textSize="@dimen/d_sp_16"
                            app:layout_constraintEnd_toEndOf="parent" />

                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginHorizontal="@dimen/d_dp_16"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/d_dp_12"
                            android:text="身份证号"
                            android:textColor="#000000"
                            android:textSize="@dimen/d_sp_16"
                            app:layout_constraintLeft_toLeftOf="parent" />

                        <EditText
                            android:id="@+id/tv_idcard"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_marginStart="@dimen/d_dp_16"
                            android:layout_marginTop="@dimen/d_dp_12"
                            android:layout_marginEnd="@dimen/d_dp_10"
                            android:autofillHints=""
                            android:background="@null"
                            android:gravity="end"
                            android:text=""
                            android:hint="请输入身份证号"
                            android:inputType="textPersonName|textFilter"
                            android:maxWidth="@dimen/d_dp_300"
                            android:maxLength="18"
                            android:textColor="#000000"
                            android:textSize="@dimen/d_sp_16"
                            app:layout_constraintEnd_toEndOf="parent" />

                    </RelativeLayout>


                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>


            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="10dp">

                <ImageView
                    android:id="@+id/imgyuanquan2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/jibenxinxi2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:text="当前居住地址"
                    android:textColor="#222"
                    android:textSize="16dp"
                    android:textStyle="bold"
                    app:layout_constraintLeft_toRightOf="@+id/imgyuanquan2"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:text="请选择长期居住城市"
                    android:textColor="#666"
                    android:textSize="12dp"
                    app:layout_constraintLeft_toRightOf="@+id/imgyuanquan2"
                    app:layout_constraintTop_toBottomOf="@+id/jibenxinxi2" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <RelativeLayout
                android:id="@+id/addressRela"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginHorizontal="@dimen/d_dp_16"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="工作城市"
                    android:textColor="#000000"
                    android:textSize="@dimen/d_sp_16"
                    app:layout_constraintLeft_toLeftOf="parent" />


                <TextView
                    android:id="@+id/address"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:drawableEnd="@mipmap/icon_right"
                    android:text="请选择城市"
                    android:textColor="#555"
                    android:textSize="@dimen/d_sp_16" />

            </RelativeLayout>


            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="10dp">


                <ImageView
                    android:id="@+id/imgyuanquan3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/jibenxinxi3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:text="个人信用情况"
                    android:textColor="#222"
                    android:textSize="16dp"
                    android:textStyle="bold"
                    app:layout_constraintLeft_toRightOf="@+id/imgyuanquan3"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:text="请根据个人的资质情况选择"
                    android:textColor="#666"
                    android:textSize="12dp"
                    app:layout_constraintLeft_toRightOf="@+id/imgyuanquan3"
                    app:layout_constraintTop_toBottomOf="@+id/jibenxinxi3" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:layout_marginTop="15dp"
                android:orientation="vertical"
                android:paddingHorizontal="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginRight="10dp"
                    android:text="当前征信情况"
                    android:textColor="#000000"
                    android:textSize="15dp"
                    app:layout_constraintLeft_toLeftOf="parent" />

                <com.yundou.loans.widget.SingleSelectButtonGroup
                    android:id="@+id/yuqi_Group"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_alignParentRight="true" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:layout_marginTop="15dp"
                android:orientation="vertical"
                android:paddingHorizontal="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginRight="10dp"
                    android:text="征信"
                    android:textColor="#000000"
                    android:textSize="15dp"
                    app:layout_constraintLeft_toLeftOf="parent" />

                <com.yundou.loans.widget.SingleSelectButtonGroup
                    android:id="@+id/zhengxin_Group"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_alignParentRight="true" />

            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:layout_marginTop="15dp"
                android:orientation="vertical"
                android:paddingHorizontal="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginRight="10dp"
                    android:text="芝麻分"
                    android:textColor="#000000"
                    android:textSize="15dp"
                    app:layout_constraintLeft_toLeftOf="parent" />

                <com.yundou.loans.widget.SingleSelectButtonGroup
                    android:id="@+id/zhima_Group"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_alignParentRight="true" />

            </LinearLayout>


            <com.google.android.material.button.MaterialButton
                android:id="@+id/txt_feedback_submit"
                style="@style/PulicMaterialButton"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_below="@+id/lilvTv"
                android:layout_marginLeft="50dp"
                android:layout_marginTop="50dp"
                android:layout_marginRight="50dp"
                android:layout_weight="1"
                android:backgroundTint="@color/main_color"
                android:gravity="center"
                android:text="下一步"
                android:textColor="@color/white"
                android:textSize="20dp"
                app:cornerRadius="30dp" />


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"
                android:gravity="center_horizontal"
                android:text="黔ICP备2022009504号-25"
                android:textSize="@dimen/d_sp_12"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_horizontal"
                android:paddingBottom="@dimen/dp_20"
                android:text="@string/app_gongsi"
                android:textSize="@dimen/d_sp_12" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</layout>
