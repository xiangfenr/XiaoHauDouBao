<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#EFF4FF">

        <!-- 顶部橙色背景图 -->
        <ImageView
            android:id="@+id/header_bg_img"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:scaleType="centerCrop"
            android:src="@mipmap/form_bg_orange" />

        <!-- 标题栏 -->
        <RelativeLayout
            android:id="@+id/title_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp">

            <ImageView
                android:id="@+id/back"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:padding="6dp"
                android:src="@mipmap/turn_left_black" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="申请贷款"
                android:textColor="@color/black"
                android:textSize="20dp"
                android:textStyle="bold" />

        </RelativeLayout>

        <!-- 步骤指示器 -->
        <LinearLayout
            android:id="@+id/step_indicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/title_container"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingVertical="14dp">

            <TextView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/jxgoo_shape_radius15dp_white_solid"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/main_color"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="基本信息"
                android:textColor="@color/black"
                android:textSize="13sp"
                android:textStyle="bold" />

            <View
                android:layout_width="40dp"
                android:layout_height="1dp"
                android:layout_marginHorizontal="8dp"
                android:background="#AACCFF" />

            <TextView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/gray_button_bg"
                android:gravity="center"
                android:text="2"
                android:textColor="#AAAAAA"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="资质信息"
                android:textColor="#AAAAAA"
                android:textSize="13sp" />

        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/step_indicator">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingBottom="30dp"
                tools:context="com.example.yongliu.bottomnavigationview.MainActivity">

                <!-- 基本信息卡片 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/d_dp_16"
                    android:layout_marginTop="12dp"
                    android:background="@color/color_ffffff"
                    android:elevation="3dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#F0F6FF"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/d_dp_16"
                        android:paddingTop="13dp"
                        android:paddingEnd="@dimen/d_dp_16"
                        android:paddingBottom="13dp">

                        <View
                            android:layout_width="4dp"
                            android:layout_height="18dp"
                            android:background="@color/main_color" />

                        <TextView
                            android:id="@+id/jibenxinxi"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:drawablePadding="4dp"
                            android:text="基本信息"
                            android:textColor="#1A3A6B"
                            android:textSize="16dp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:background="#E8EEFA" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="5dp"
                        android:orientation="vertical">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:layout_marginHorizontal="@dimen/d_dp_16"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tv_data"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/d_dp_12"
                                android:text="姓名"
                                android:textColor="#000000"
                                android:textSize="@dimen/d_sp_16"
                                app:layout_constraintLeft_toLeftOf="parent" />

                            <EditText
                                android:id="@+id/tv_zhong_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_marginStart="@dimen/d_dp_16"
                                android:layout_marginTop="@dimen/d_dp_12"
                                android:autofillHints=""
                                android:background="@null"
                                android:gravity="end"
                                android:hint="请输入您的真实姓名"
                                android:maxWidth="@dimen/d_dp_300"
                                android:textColor="#000000"
                                android:textSize="@dimen/d_sp_16"
                                app:layout_constraintEnd_toEndOf="parent" />

                        </RelativeLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="0.5dp"
                            android:layout_marginHorizontal="@dimen/d_dp_16"
                            android:background="#F0F0F0" />

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="@dimen/d_dp_16"
                            android:orientation="horizontal"
                            android:visibility="gone">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/d_dp_12"
                                android:text="手机号"
                                android:textColor="#000000"
                                android:textSize="@dimen/d_sp_16"
                                app:layout_constraintLeft_toLeftOf="parent" />

                            <EditText
                                android:id="@+id/tv_number"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_marginStart="@dimen/d_dp_16"
                                android:layout_marginTop="@dimen/d_dp_12"
                                android:layout_marginEnd="@dimen/d_dp_16"
                                android:autofillHints=""
                                android:background="@color/color_ffffff"
                                android:gravity="end"
                                android:hint="请输入手机号码"
                                android:inputType="number"
                                android:maxWidth="@dimen/d_dp_300"
                                android:textColor="#000000"
                                android:textSize="@dimen/d_sp_16"
                                app:layout_constraintEnd_toEndOf="parent" />

                        </RelativeLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="0.5dp"
                            android:layout_marginHorizontal="@dimen/d_dp_16"
                            android:background="#F0F0F0" />

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:layout_marginHorizontal="@dimen/d_dp_16"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/d_dp_12"
                                android:text="身份证号"
                                android:textColor="#000000"
                                android:textSize="@dimen/d_sp_16"
                                app:layout_constraintLeft_toLeftOf="parent" />

                            <EditText
                                android:id="@+id/tv_idcard"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_marginStart="@dimen/d_dp_16"
                                android:layout_marginTop="@dimen/d_dp_12"
                                android:autofillHints=""
                                android:background="@null"
                                android:gravity="end"
                                android:hint="请输入身份证号"
                                android:inputType="textPersonName|textFilter"
                                android:maxLength="18"
                                android:maxWidth="@dimen/d_dp_300"
                                android:textColor="#000000"
                                android:textSize="@dimen/d_sp_16"
                                app:layout_constraintEnd_toEndOf="parent" />

                        </RelativeLayout>

                    </LinearLayout>

                </LinearLayout>

                <!-- 居住地址卡片 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/d_dp_16"
                    android:layout_marginTop="12dp"
                    android:background="@color/color_ffffff"
                    android:elevation="3dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#F0F6FF"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/d_dp_16"
                        android:paddingTop="13dp"
                        android:paddingEnd="@dimen/d_dp_16"
                        android:paddingBottom="13dp">

                        <View
                            android:layout_width="4dp"
                            android:layout_height="18dp"
                            android:background="@color/main_color" />

                        <TextView
                            android:id="@+id/jibenxinxi2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:drawablePadding="4dp"
                            android:text="居住地址"
                            android:textColor="#1A3A6B"
                            android:textSize="16dp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:background="#E8EEFA" />

                    <RelativeLayout
                        android:id="@+id/addressRela"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="工作城市"
                            android:textColor="#000000"
                            android:textSize="@dimen/d_sp_16"
                            app:layout_constraintLeft_toLeftOf="parent" />

                        <TextView
                            android:id="@+id/address"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:drawableEnd="@mipmap/icon_right"
                            android:text="请选择城市"
                            android:textColor="#555"
                            android:textSize="@dimen/d_sp_16" />

                    </RelativeLayout>

                </LinearLayout>

                <!-- 资产信息卡片 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/d_dp_16"
                    android:layout_marginTop="12dp"
                    android:background="@color/color_ffffff"
                    android:elevation="3dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#F0F6FF"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/d_dp_16"
                        android:paddingTop="13dp"
                        android:paddingEnd="@dimen/d_dp_16"
                        android:paddingBottom="13dp">

                        <View
                            android:layout_width="4dp"
                            android:layout_height="18dp"
                            android:background="@color/main_color" />

                        <TextView
                            android:id="@+id/jibenxinxi3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:drawablePadding="4dp"
                            android:text="资产信息"
                            android:textColor="#1A3A6B"
                            android:textSize="16dp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:background="#E8EEFA" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:paddingHorizontal="@dimen/d_dp_16"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginRight="10dp"
                            android:text="当前逾期情况"
                            android:textColor="#000000"
                            android:textSize="15dp"
                            app:layout_constraintLeft_toLeftOf="parent" />

                        <com.yundou.loans.widget.SingleSelectButtonGroup
                            android:id="@+id/yuqi_Group"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_alignParentRight="true" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:layout_marginHorizontal="@dimen/d_dp_16"
                        android:layout_marginTop="10dp"
                        android:background="#F0F0F0" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:paddingHorizontal="@dimen/d_dp_16"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginRight="10dp"
                            android:text="信用卡"
                            android:textColor="#000000"
                            android:textSize="15dp"
                            app:layout_constraintLeft_toLeftOf="parent" />

                        <com.yundou.loans.widget.SingleSelectButtonGroup
                            android:id="@+id/xinyongqk_Group"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_alignParentRight="true" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:layout_marginHorizontal="@dimen/d_dp_16"
                        android:layout_marginTop="10dp"
                        android:background="#F0F0F0" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:paddingHorizontal="@dimen/d_dp_16"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginRight="10dp"
                            android:text="芝麻信用分"
                            android:textColor="#000000"
                            android:textSize="15dp"
                            app:layout_constraintLeft_toLeftOf="parent" />

                        <com.yundou.loans.widget.SingleSelectButtonGroup
                            android:id="@+id/zhima_Group"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_alignParentRight="true" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:background="#00000000" />

                </LinearLayout>

                <!-- 下一步按钮 -->
                <TextView
                    android:id="@+id/txt_feedback_submit"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginRight="20dp"
                    android:gravity="center"
                    android:text="下一步"
                    android:background="@drawable/loginco"
                    android:textColor="@color/white"
                    android:textSize="20dp"
                    app:cornerRadius="30dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="20dp"
                    android:gravity="center_horizontal"
                    android:text="黔ICP备2022009504号-25"
                    android:textSize="@dimen/d_sp_12"
                    android:visibility="gone" />

<!--                <TextView-->
<!--                    android:layout_width="match_parent"-->
<!--                    android:layout_height="wrap_content"-->
<!--                    android:layout_marginTop="10dp"-->
<!--                    android:gravity="center_horizontal"-->
<!--                    android:paddingBottom="@dimen/dp_20"-->
<!--                    android:text="@string/app_gongsi"-->
<!--                    android:textSize="@dimen/d_sp_12" />-->

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </RelativeLayout>

</layout>