<?xml version="1.0" encoding="utf-8"?><!--智享贷 表单-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FFFFFF"
            android:orientation="vertical"
            tools:context="com.example.yongliu.bottomnavigationview.MainActivity">


            <!--  第一步 职业-->
            <TextView
                android:id="@+id/kyd_issuetv1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/d_dp_16"
                android:layout_marginTop="20dp"
                android:text="职业"
                android:textColor="#000000"
                android:textSize="@dimen/d_sp_18"
                android:textStyle="bold"
                app:layout_constraintLeft_toLeftOf="parent" />

            <com.yundou.loans.widget.SingleSelectButtonGroup
                android:id="@+id/kydGroup1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dp" />

            <!--  第二步 社保-->
            <TextView
                android:id="@+id/kyd_issuetv2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/d_dp_16"
                android:layout_marginTop="20dp"
                android:text="社保缴纳时间"
                android:textColor="#000000"
                android:textSize="@dimen/d_sp_18"
                android:textStyle="bold"
                app:layout_constraintLeft_toLeftOf="parent" />

            <com.yundou.loans.widget.SingleSelectButtonGroup
                android:id="@+id/kydGroup2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dp" />

            <!--  第三步 公积金信息-->
            <TextView
                android:id="@+id/kyd_issuetv3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/d_dp_16"
                android:layout_marginTop="20dp"
                android:text="公积金信息"
                android:textColor="#000000"
                android:textSize="@dimen/d_sp_18"
                android:textStyle="bold"
                app:layout_constraintLeft_toLeftOf="parent" />

            <com.yundou.loans.widget.SingleSelectButtonGroup
                android:id="@+id/kydGroup3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dp" />

            <!--  第四步 车辆信息-->
            <TextView
                android:id="@+id/kyd_issuetv4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/d_dp_16"
                android:layout_marginTop="20dp"
                android:text="车辆信息"
                android:textColor="#000000"
                android:textSize="@dimen/d_sp_18"
                android:textStyle="bold"
                app:layout_constraintLeft_toLeftOf="parent" />

            <com.yundou.loans.widget.SingleSelectButtonGroup
                android:id="@+id/kydGroup4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dp" />

            <!--  第五步 房产信息-->
            <TextView
                android:id="@+id/kyd_issuetv5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/d_dp_16"
                android:layout_marginTop="20dp"
                android:text="房产信息"
                android:textColor="#000000"
                android:textSize="@dimen/d_sp_18"
                android:textStyle="bold"
                app:layout_constraintLeft_toLeftOf="parent" />

            <com.yundou.loans.widget.SingleSelectButtonGroup
                android:id="@+id/kydGroup5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dp" />

            <!--  第六步 芝麻分-->
            <TextView
                android:id="@+id/kyd_issuetv6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/d_dp_16"
                android:layout_marginTop="20dp"
                android:text="芝麻分"
                android:textColor="#000000"
                android:textSize="@dimen/d_sp_18"
                android:textStyle="bold"
                app:layout_constraintLeft_toLeftOf="parent" />

            <com.yundou.loans.widget.SingleSelectButtonGroup
                android:id="@+id/kydGroup6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dp" />

            <TextView
                android:id="@+id/kyd_issuetv7_userinfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/d_dp_16"
                android:layout_marginTop="20dp"
                android:text="基本信息"
                android:textColor="#000000"
                android:textSize="@dimen/d_sp_18"
                android:textStyle="bold"
                app:layout_constraintLeft_toLeftOf="parent" />

            <TextView
                android:id="@+id/kyd_issuetv7_dis"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/d_dp_16"
                android:layout_marginTop="5dp"
                android:text="描述"
                android:textColor="#000000"
                android:textSize="@dimen/d_sp_13"
                app:layout_constraintLeft_toLeftOf="parent" />


            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginHorizontal="@dimen/d_dp_16"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_data"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/d_dp_12"
                    android:text="姓名"
                    android:textColor="#000000"
                    android:textSize="@dimen/d_sp_16"
                    app:layout_constraintLeft_toLeftOf="parent" />

                <EditText
                    android:id="@+id/tv_zhong_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_marginStart="@dimen/d_dp_16"
                    android:layout_marginTop="@dimen/d_dp_12"
                    android:layout_marginEnd="@dimen/d_dp_16"
                    android:autofillHints=""
                    android:background="@color/color_ffffff"
                    android:gravity="end"
                    android:hint="请输入您的姓名"
                    android:maxWidth="@dimen/d_dp_300"
                    android:text=""
                    android:textColor="#000000"
                    android:textSize="@dimen/d_sp_16"
                    app:layout_constraintEnd_toEndOf="parent" />

            </RelativeLayout>


            <!--            手机号-->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/d_dp_16"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/d_dp_12"
                    android:text="手机号"
                    android:textColor="#000000"
                    android:textSize="@dimen/d_sp_16"
                    app:layout_constraintLeft_toLeftOf="parent" />

                <EditText
                    android:id="@+id/tv_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_marginStart="@dimen/d_dp_16"
                    android:layout_marginTop="@dimen/d_dp_12"
                    android:layout_marginEnd="@dimen/d_dp_16"
                    android:autofillHints=""
                    android:background="@color/color_ffffff"
                    android:gravity="end"
                    android:hint="请输入手机号码"
                    android:inputType="number"
                    android:maxWidth="@dimen/d_dp_300"
                    android:textColor="#000000"
                    android:textSize="@dimen/d_sp_16"
                    app:layout_constraintEnd_toEndOf="parent" />

            </RelativeLayout>


            <!--            身份证号-->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/d_dp_16"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/d_dp_12"
                    android:text="身份证号"
                    android:textColor="#000000"
                    android:textSize="@dimen/d_sp_16"
                    app:layout_constraintLeft_toLeftOf="parent" />

                <EditText
                    android:id="@+id/tv_idcard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_marginStart="@dimen/d_dp_16"
                    android:layout_marginTop="@dimen/d_dp_12"
                    android:layout_marginEnd="@dimen/d_dp_16"
                    android:autofillHints=""
                    android:background="@color/color_ffffff"
                    android:gravity="end"
                    android:hint="请输入本人真实身份证号"
                    android:inputType="textPersonName|textFilter"
                    android:maxWidth="@dimen/d_dp_300"
                    android:maxLength="18"
                    android:text=""
                    android:textColor="#000000"
                    android:textSize="@dimen/d_sp_16"
                    app:layout_constraintEnd_toEndOf="parent" />

            </RelativeLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginStart="@dimen/d_dp_16"
                android:layout_marginTop="@dimen/d_dp_15"
                android:alpha="0.1"
                android:background="#000000"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_zhong" />

            <!--年龄-->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/d_dp_16"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_age"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/d_dp_12"
                    android:text="年龄"
                    android:textColor="#000000"
                    android:textSize="@dimen/d_sp_16"
                    app:layout_constraintLeft_toLeftOf="parent" />

                <EditText
                    android:id="@+id/tv_age_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_marginStart="@dimen/d_dp_16"
                    android:layout_marginTop="@dimen/d_dp_12"
                    android:layout_marginEnd="@dimen/d_dp_16"
                    android:autofillHints=""
                    android:inputType="number"
                    android:background="@color/color_ffffff"
                    android:gravity="end"
                    android:hint="请输入年龄"
                    android:maxWidth="@dimen/d_dp_300"
                    android:text=""
                    android:textColor="#000000"
                    android:textSize="@dimen/d_sp_16"
                    app:layout_constraintEnd_toEndOf="parent" />

            </RelativeLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginStart="@dimen/d_dp_16"
                android:layout_marginTop="@dimen/d_dp_15"
                android:alpha="0.1"
                android:background="#000000"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_zhong" />

            <!--性别-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/d_dp_16"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_sex"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/d_dp_12"
                    android:text="性别"
                    android:textColor="#000000"
                    android:textSize="@dimen/d_sp_16"
                    app:layout_constraintLeft_toLeftOf="parent" />

                <com.yundou.loans.widget.SingleSelectButtonGroup
                    android:id="@+id/kydGroup7"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="10dp" />

            </LinearLayout>

            <TextView
                android:id="@+id/kyd_issuetv7_address"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/d_dp_16"
                android:layout_marginTop="20dp"
                android:text="当前居住地址"
                android:textColor="#000000"
                android:textSize="@dimen/d_sp_18"
                android:textStyle="bold"
                app:layout_constraintLeft_toLeftOf="parent" />

            <TextView
                android:id="@+id/kyd_issuetv7_addressdis"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/d_dp_16"
                android:layout_marginTop="5dp"
                android:text="描述"
                android:textColor="#000000"
                android:textSize="@dimen/d_sp_13"
                app:layout_constraintLeft_toLeftOf="parent" />

            <RelativeLayout
                android:id="@+id/addressRela"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="10dp"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginHorizontal="@dimen/d_dp_16"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="当前居住城市"
                    android:textColor="#000000"
                    android:textSize="@dimen/d_sp_16"
                    app:layout_constraintLeft_toLeftOf="parent" />


                <TextView
                    android:id="@+id/address"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:drawableEnd="@mipmap/icon_right"
                    android:text="请选择城市"
                    android:textColor="#000000"
                    android:textSize="@dimen/d_sp_16" />

            </RelativeLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginStart="@dimen/d_dp_16"
                android:layout_marginTop="@dimen/d_dp_15"
                android:alpha="0.1"
                android:background="#000000"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_zhong" />

            <TextView
                android:id="@+id/kyd_issuetv7_xinyong"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/d_dp_16"
                android:layout_marginTop="20dp"
                android:text="当前逾期情况"
                android:textColor="#000000"
                android:textSize="@dimen/d_sp_18"
                android:textStyle="bold"
                app:layout_constraintLeft_toLeftOf="parent" />

            <com.yundou.loans.widget.SingleSelectButtonGroup
                android:id="@+id/kydGroup7xinyong"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dp" />



            <TextView
                android:id="@+id/txt_feedback_submit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_marginLeft="30dip"
                android:layout_marginTop="20dip"
                android:layout_marginRight="30dip"
                android:layout_marginBottom="30dip"
                android:background="@drawable/logincodebg"
                android:gravity="center"
                android:paddingTop="10dip"
                android:paddingBottom="12dip"
                android:text="提交申请"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:gravity="center_horizontal"
                android:text="黔ICP备2022009504号"
                android:textSize="@dimen/d_sp_12" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:paddingBottom="@dimen/dp_20"
                android:text="贵州贵安新区贝花小额贷款有限公司"
                android:textSize="@dimen/d_sp_12" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</layout>
