<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 按下状态 -->
    <item android:color="#ffffff" android:state_pressed="true"/> <!-- 点击红色 -->

    <!-- 选中状态（可选，如果不需要可以删掉） -->
    <item android:color="#ffffff" android:state_selected="true"/> <!-- 选中橙色 -->

    <!-- 默认状态 -->
    <item android:color="#000000"/> <!-- 默认黑色 -->
</selector>