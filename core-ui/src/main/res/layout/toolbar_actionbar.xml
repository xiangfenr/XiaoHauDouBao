<androidx.appcompat.widget.Toolbar xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/toolbar_actionbar"
    android:layout_width="match_parent"
    android:layout_height="@dimen/d_dp_44"
    android:layout_gravity="center"
    android:elevation="0dp"
    android:background="#FFFFFF"
    android:gravity="center"
    app:contentInsetEnd="0dp"
    app:contentInsetLeft="0dp"
    app:contentInsetStart="0dp"
    app:contentInsetStartWithNavigation="0dp"
    app:navigationIcon="@mipmap/icon_web_result"
    app:popupTheme="@style/ThemeOverlay.AppCompat.Dark">

    <ImageView
        android:id="@+id/ivLeftClose"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="left|center_vertical"
        android:padding="@dimen/d_dp_5"
        android:src="@mipmap/closebar"
        android:visibility="gone" />

    <TextView
        android:id="@+id/toolbar_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginLeft="@dimen/d_dp_5"
        android:layout_marginRight="@dimen/d_dp_5"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/color_txt"
        android:textSize="@dimen/d_sp_18"
        tools:text="人保寿险管家" />

    <TextView
        android:id="@+id/tv_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="right"
        android:layout_marginRight="@dimen/d_dp_15"
        android:ellipsize="end"
        android:gravity="center"
        android:textColor="@color/color_txt"
        android:textSize="@dimen/d_sp_16"
        tools:text="这是一个标题" />

    <ImageView
        android:id="@+id/ivRightClose"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="right|center_vertical"
        android:layout_marginRight="@dimen/d_dp_15"
        android:background="@mipmap/closebar"
        android:visibility="gone" />


</androidx.appcompat.widget.Toolbar>